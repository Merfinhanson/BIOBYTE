# ---------------------------------------------------------------------------
# BIOBYTE — environment variables
#
# Copy this file to `.env.local` for local development, or add every value
# under Settings -> Environment Variables in the Vercel dashboard.
#
# NEVER commit a filled-in copy of this file. `.env*` is git-ignored;
# only this `.env.example` file is tracked.
# ---------------------------------------------------------------------------


# --- Firebase (frontend) ----------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to the browser, so these
# must keep that prefix. These are public client identifiers, not secrets —
# Firebase Auth and Firestore rules are what actually protect your data.
# Copy them from Firebase console -> Project settings -> Your apps -> SDK setup.
#
# Set locally in `.env.local`, and in Vercel for production builds.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# --- Microsoft Entra ID (Azure AD) app registration -------------------------
# Required. Used by the serverless function to request an app-only access
# token for Microsoft Graph. Get these from:
#   Azure portal -> Microsoft Entra ID -> App registrations -> New registration
#   -> Authentication -> Add a platform -> Web -> and note the values below.
#
# "Directory (tenant) ID"  -> MICROSOFT_TENANT_ID
# "Application (client) ID" -> MICROSOFT_CLIENT_ID
# "Client secret" value     -> MICROSOFT_CLIENT_SECRET (only shown once)

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=


# --- Excel workbook ---------------------------------------------------------
# The workbook must contain a TABLE (Insert -> Table), not just a sheet range.
# The table's column headers must match COLUMNS in api/register.js exactly,
# in the same order, or Microsoft Graph will reject the row.
#
# EXCEL_WORKBOOK_ID : the workbook file id (not the URL).
#   From the workbook URL: .../d/<WORKBOOK_ID>/edit  or  .../drive/u/0/<WORKBOOK_ID>
# EXCEL_DRIVE_ID    : the drive holding the workbook.
#   OneDrive/SharePoint default is usually `b` in the Graph shortcut:
#   https://graph.microsoft.com/v1.0/drives/b/items/<WORKBOOK_ID>/workbook/tables
EXCEL_WORKBOOK_ID=
EXCEL_TABLE_NAME=


# --- Excel drive (only if you cannot use the `b` shortcut) ------------------
# Optional. Set this ONLY if EXCEL_WORKBOOK_ID lives in a specific shared
# drive or SharePoint library that requires an explicit drive id.
# Leave blank to use the `b` (default drive) shortcut.
EXCEL_DRIVE_ID=


# --- Deployment -------------------------------------------------------------
# Optional. Vercel provides this automatically on every deployment.
# Used only for logging/self-links; the API route does not depend on it.
VERCEL_URL=